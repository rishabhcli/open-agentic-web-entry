              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": []
        }
      },
      "instructions": "Call tool_holidays_between and return its result unchanged.",
      "tools": [
        "tool_holidays_between"
      ],
      "plan": {
        "steps": [
          {
